<%- include("_header") -%>
<h1>Delete this record?</h1>
<form action="/delete/<%= model.book_id %>" method="post">
  <%- include("_display") -%>
  <div class="mb-3 row">
    <div class="col-sm-10 offset-sm-2">
      <button type="submit" class="btn btn-danger">Delete</button>
      <a class="btn btn-outline-dark" href="/books">Cancel</a>
    </div>
  </div>
</form>
<%- include("_footer") -%>
