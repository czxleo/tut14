<div class="mb-3 row">
  <label class="col-form-label col-sm-2" for="title">Title</label>
  <div class="col-sm-8">
    <input autofocus required class="form-control" id="title" name="title" maxlength="100" value="<%= model.title || '' %>">
  </div>
</div>

<div class="mb-3 row">
  <label class="col-form-label col-sm-2" for="author">Author</label>
  <div class="col-sm-8">
    <input required class="form-control" id="author" name="author" maxlength="100" value="<%= model.author || '' %>">
  </div>
</div>

<div class="mb-3 row">
  <label class="col-form-label col-sm-2" for="comments">Comments</label>
  <div class="col-sm-10">
    <textarea class="form-control" id="comments" name="comments" maxlength="32000" rows="7"><%= model.comments || '' %></textarea>
  </div>
</div>
